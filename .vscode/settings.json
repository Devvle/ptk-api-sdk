{
	"workbench.colorCustomizations": {
		"activityBar.background": "#2c1e85",
		"activityBarBadge.background": "#8a38c9",
		"activityBarBadge.foreground": "#ffffff",
		"titleBar.activeBackground": "#534fd5",
		"titleBar.activeForeground": "#ffffff",
		"titleBar.inactiveBackground": "#262496",
		"titleBar.inactiveForeground": "#ffffff",
		"statusBar.background": "#181c8b",
		"statusBar.foreground": "#ffffff",
		"panel.border": "#524fe73e",
		"scrollbarSlider.background": "#5c4fe735"
	},
	"editor.codeActionsOnSave": {
		"source.organizeImports": "explicit",
		"source.fixAll": "explicit"
	},
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"workbench.iconTheme": "vscode-icons",
	"editor.formatOnSave": true
}
